=== Programa tipado (conversões explícitas) ===
    int x = 10;
    float media = i2f((x / 4));
    float y = (i2f(x) / 4.0);
    string s = ("y = " + str(y));
    bool ok = ((y >= 2.5) && !(x == 0));
    if (ok)
    {
        print(s);
        int x = 3;
        print((i2f(x) * 2.0));
    }
    else
    {
        print("não ok");
    }
    while (x > 0)
    {
        x = (x - 3);
    }
