// TCC2101-Calc.cup | Aula 21
// Parser JCup (CUP) para a calculadora.
// Build: veja TCC2101-Calc.flex (o scanner CalcLexer vem de lá).
// Entrada: uma ou mais expressões terminadas em ';'  — ex.: 2 + 3 * (4 - 1);

import java_cup.runtime.*;

parser code {:
    public static void main(String[] args) throws Exception {
        String arquivo = args.length > 0 ? args[0] : "entrada.txt";
        CalcLexer lexer = new CalcLexer(new java.io.FileReader(arquivo));
        new parser(lexer).parse();
    }

    // Erro sintático com linha e coluna (o CUP chama este método)
    public void syntax_error(Symbol s) {
        System.err.println("Erro sintático na linha " + s.left + ", coluna " + s.right);
    }
:}

terminal PLUS, MINUS, TIMES, DIV, LPAREN, RPAREN, SEMI;
terminal Double NUM;

non terminal        calc, linha;
non terminal Double expr, term, factor;

precedence left PLUS, MINUS;
precedence left TIMES, DIV;

start with calc;

calc  ::= calc linha | linha ;
linha ::= expr:e SEMI {: System.out.println("Resultado: " + e); :} ;

expr ::= expr:e1 PLUS term:e2 {: RESULT = e1 + e2; :}
       | expr:e1 MINUS term:e2 {: RESULT = e1 - e2; :}
       | term:t {: RESULT = t; :}
       ;

term ::= term:t1 TIMES factor:f {: RESULT = t1 * f; :}
       | term:t1 DIV factor:f   {: RESULT = t1 / f; :}
       | factor:f               {: RESULT = f; :}
       ;

factor ::= LPAREN expr:e RPAREN {: RESULT = e; :}
         | NUM:n                {: RESULT = n; :}
         ;
